<?xml version="1.0" encoding="utf-8"?>
<!-- b17 · Item da lista "Últimas refeições" (rvMeals). Dados do SQLite no Módulo 5. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingVertical="10dp">
    <TextView
        android:id="@+id/tvMealWhen"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:textColor="@color/ink" android:textSize="12.5sp" android:textStyle="bold"
        tools:text="Hoje 12:20 · Almoço"/>
    <TextView
        android:id="@+id/tvMealValues"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/primary_dark" android:textSize="12.5sp" android:textStyle="bold"
        tools:text="45g · 3,5 UI"/>
</LinearLayout>
