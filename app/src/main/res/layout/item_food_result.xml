<?xml version="1.0" encoding="utf-8"?>

<!-- b9 · uma linha de resultado do diálogo de busca de alimento (Module 7). Compartilhada por
     FoodLocalAdapter e FoodOnlineAdapter — mesma estrutura visual, conteúdo diferente. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:minHeight="48dp"
    android:paddingHorizontal="4dp" android:paddingVertical="10dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <TextView android:id="@+id/tvFoodResultName"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold"
        tools:text="Arroz branco cozido"/>

    <TextView android:id="@+id/tvFoodResultDetail"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_muted_light" android:textSize="11sp" android:textStyle="bold"
        tools:text="porção de 100 g · 28 g de carboidrato"/>
</LinearLayout>
