<?xml version="1.0" encoding="utf-8"?>

<!-- Module 7 · b-map. Root is a ConstraintLayout, not a ScrollView: the map needs every drag
     gesture for itself, so only the panel below it (svContent) scrolls. cvMap and cvNoMapsKey
     share the same top anchor and never show at once — AlertMapActivity picks one based on
     AlertMapUiState.hasMapsApiKey, and the barrier below both keeps svContent's top steady
     either way. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F5F3FA" android:padding="16dp">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp" android:layout_height="48dp"
        android:background="@drawable/bg_circle_white" android:src="@drawable/ic_back_ink"
        android:contentDescription="Voltar para a Área dos Pais"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Mapa de Alertas" android:textColor="@color/ink" android:textSize="19sp" android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnBack" app:layout_constraintStart_toEndOf="@id/btnBack"/>

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="última localização e diagnóstico de sinal"
        android:textColor="@color/text_muted_light" android:textSize="10.5sp" android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" app:layout_constraintStart_toEndOf="@id/btnBack"/>

    <!-- Map — SupportMapFragment is added programmatically to flMapContainer only when
         AlertMapUiState.hasMapsApiKey is true; getMapAsync never runs otherwise. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvMap"
        android:layout_width="0dp" android:layout_height="220dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="18dp" app:cardElevation="0dp"
        app:cardBackgroundColor="@color/lavender_bg"
        app:strokeWidth="1dp" app:strokeColor="#E3DAF7"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/flMapContainer"
            android:layout_width="match_parent" android:layout_height="match_parent"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Four map types, requirement of the screen — normal/satellite/hybrid/terrain. -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cgMapType"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:singleSelection="true" app:selectionRequired="true" app:chipSpacingVertical="2dp"
        app:layout_constraintTop_toBottomOf="@id/cvMap"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.chip.Chip android:id="@+id/chipMapNormal" style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="Normal" android:checked="true"/>
        <com.google.android.material.chip.Chip android:id="@+id/chipMapSatellite" style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="Satélite"/>
        <com.google.android.material.chip.Chip android:id="@+id/chipMapHybrid" style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="Híbrido"/>
        <com.google.android.material.chip.Chip android:id="@+id/chipMapTerrain" style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="Terreno"/>
    </com.google.android.material.chip.ChipGroup>

    <!-- Shown instead of cvMap/cgMapType when the build has no real Maps key. Coordinates and
         addresses stay visible in svContent below either way. -->
    <LinearLayout
        android:id="@+id/cvNoMapsKey"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:orientation="vertical"
        android:background="@drawable/bg_chip_purple_soft"
        android:paddingHorizontal="15dp" android:paddingVertical="13dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="O mapa precisa de uma chave configurada"
            android:textColor="@color/primary_dark" android:textSize="13sp" android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Este aparelho não tem uma chave de mapas válida, então o desenho do mapa fica oculto. As coordenadas e os endereços continuam disponíveis em texto logo abaixo."
            android:textColor="@color/primary_dark" android:textSize="11sp" android:textStyle="bold"
            android:lineSpacingMultiplier="1.4"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierMapSection"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="cvMap,cgMapType,cvNoMapsKey"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svContent"
        android:layout_width="0dp" android:layout_height="0dp"
        android:layout_marginTop="14dp" android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/barrierMapSection"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Requirement 3 — search an address, camera moves to it on success. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="18dp" app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeWidth="1dp" app:strokeColor="#E3DAF7">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingBottom="8dp" android:text="BUSCAR ENDEREÇO"
                        android:textColor="@color/text_muted_light" android:textSize="12sp"
                        android:textStyle="bold" android:letterSpacing="0.05"/>
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilSearchAddress"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:hint="Rua, bairro ou cidade"
                            app:boxStrokeColor="@color/primary" app:hintTextColor="@color/primary_dark">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSearchAddress"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="textPostalAddress" android:maxLines="1"
                                android:textColor="@color/ink" android:textStyle="bold"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSearchAddress"
                            android:layout_width="wrap_content" android:layout_height="52dp"
                            android:layout_marginStart="8dp" android:minWidth="48dp"
                            android:insetTop="0dp" android:insetBottom="0dp"
                            android:background="@drawable/bg_button_primary_3d" app:backgroundTint="@null"
                            android:text="Buscar" android:textColor="@android:color/white"
                            android:textSize="13sp" android:textStyle="bold" android:textAllCaps="false"
                            android:contentDescription="Buscar o endereço digitado"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvSearchError"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:visibility="gone"
                        android:textColor="@color/danger" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Requirement 2/3 — the point currently under discussion: a tap or a search result. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp" app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeWidth="1dp" app:strokeColor="#E3DAF7">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingBottom="6dp" android:text="PONTO SELECIONADO"
                        android:textColor="@color/text_muted_light" android:textSize="12sp"
                        android:textStyle="bold" android:letterSpacing="0.05"/>
                    <LinearLayout
                        android:id="@+id/rowResolvingAddress"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:visibility="gone">
                        <ProgressBar
                            android:layout_width="18dp" android:layout_height="18dp"
                            android:indeterminateTint="@color/primary"/>
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:text="Resolvendo endereço…"
                            android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvSelectedPoint"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Toque no mapa ou busque um endereço para ver o ponto aqui."
                        android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"
                        android:lineSpacingMultiplier="1.3"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Requirement 1 — the last place a glucose alert was ever sent from. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp" app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeWidth="1dp" app:strokeColor="#E3DAF7">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingBottom="6dp" android:text="ÚLTIMO ALERTA"
                        android:textColor="@color/text_muted_light" android:textSize="12sp"
                        android:textStyle="bold" android:letterSpacing="0.05"/>
                    <TextView
                        android:id="@+id/tvLastAlertLocation"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Nenhum alerta com localização foi enviado ainda."
                        android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"
                        android:lineSpacingMultiplier="1.3"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Requirement 4 — live tracking, on/off. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp" app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeWidth="1dp" app:strokeColor="#E3DAF7">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swFollowLocation"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Seguir minha localização" android:textColor="@color/ink"
                        android:textSize="13sp" android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvFollowedLocation"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:visibility="gone"
                        android:textColor="@color/text_muted_light" android:textSize="11.5sp" android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvFollowError"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:visibility="gone"
                        android:textColor="@color/danger" android:textSize="11.5sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Requirement 5 — GPS vs. network fix, side by side. Academic requirement: never
                 collapse this into a corner, it is what evidences the difference in requirement 5. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp" app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeWidth="1dp" app:strokeColor="#E3DAF7">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingBottom="6dp" android:text="DIAGNÓSTICO DE TECNOLOGIAS"
                        android:textColor="@color/text_muted_light" android:textSize="12sp"
                        android:textStyle="bold" android:letterSpacing="0.05"/>
                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="a precisão de cada meio de obter a posição do aparelho"
                        android:textColor="@color/text_muted_light" android:textSize="11sp" android:textStyle="bold"/>
                    <LinearLayout
                        android:id="@+id/llTechReadings"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                    <TextView
                        android:id="@+id/tvTechEmpty"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="Nenhuma tecnologia de localização respondeu ainda."
                        android:textColor="@color/text_muted_light" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
