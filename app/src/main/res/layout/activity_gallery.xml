<?xml version="1.0" encoding="utf-8"?>
<!-- b12/b13 · Galeria de Medalhas (GridView + menu de contexto). SUBSTITUI o do staging.
     Correções de fidelidade: botão Compartilhar com bg_button_white_3d (não TonalButton),
     card de streak com cardElevation 0 e número dourado, grid com margens do design. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/lavender_bg">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp" android:layout_height="48dp"
        android:layout_marginStart="16dp" android:layout_marginTop="16dp"
        android:background="@drawable/bg_circle_white" android:src="@drawable/ic_back_ink"
        android:contentDescription="Voltar"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Minhas Medalhas"
        android:textColor="@color/ink" android:textSize="21sp" android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnBack" app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvStreak"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp" app:cardElevation="0dp"
        app:cardBackgroundColor="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/btnBack">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp">
            <TextView
                android:id="@+id/tvStreakCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="5" android:textColor="@color/gold" android:textSize="44sp" android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvStreakLabel"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="dias seguidos com a glicose na meta · recorde: 9"
                android:textColor="@android:color/white" android:textSize="13sp" android:textStyle="bold"
                android:lineSpacingMultiplier="1.15"/>
            <Button
                android:id="@+id/btnShare"
                style="@style/Widget.GlicoKids.Button.Outline"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:drawableStart="@drawable/ic_share_custom_ink" android:drawablePadding="6dp"
                android:text="Compartilhar" android:textSize="12sp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <GridView
        android:id="@+id/gvMedals"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginHorizontal="10dp" android:layout_marginTop="6dp" android:layout_marginBottom="16dp"
        android:numColumns="3"
        android:horizontalSpacing="0dp" android:verticalSpacing="0dp"
        android:listSelector="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/cvStreak"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_medal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
