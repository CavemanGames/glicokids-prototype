<?xml version="1.0" encoding="utf-8"?>

<!-- b20 · conteúdo do MaterialAlertDialog de adicionar/editar contato (ViewBinding: DialogContactBinding).
     Validação no código: nome obrigatório · telefone 10–11 dígitos · e-mail válido se preenchido ·
     swReceivesReport só habilita com e-mail · Salvar desabilitado enquanto inválido. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingHorizontal="24dp" android:paddingTop="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Quem mais deve acompanhar a criança?"
            android:textColor="@color/text_muted_light" android:textSize="13sp"
            android:lineSpacingMultiplier="1.2"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilContactName"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:hint="Nome"
            app:boxStrokeColor="@color/primary" app:hintTextColor="@color/primary_dark">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContactName"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords" android:maxLength="60"
                android:textColor="@color/ink" android:textStyle="bold"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="PARENTESCO"
            android:textColor="@color/text_muted_light" android:textSize="11sp"
            android:textStyle="bold" android:letterSpacing="0.05"/>
        <!-- singleSelection: grava a string exata em contacts.relationship -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgRelationship"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:singleSelection="true" app:selectionRequired="true" app:chipSpacingVertical="2dp">
            <com.google.android.material.chip.Chip android:id="@+id/chipMother" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Mãe"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipFather" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Pai"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipGrandmother" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Avó"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipGrandfather" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Avô"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipUncle" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Tio(a)"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipCaregiver" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Cuidador(a)"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipDoctor" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Médico(a)"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipSchool" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Escola"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipOther" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Outro"/>
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilContactPhone"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="Celular"
            app:boxStrokeColor="@color/primary" app:hintTextColor="@color/primary_dark">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContactPhone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="phone" android:maxLength="16"
                android:textColor="@color/ink" android:textStyle="bold"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilContactEmail"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="E-mail (opcional)"
            app:boxStrokeColor="@color/primary" app:hintTextColor="@color/primary_dark">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContactEmail"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textEmailAddress" android:maxLength="80"
                android:textColor="@color/ink" android:textStyle="bold"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swDlgReceivesAlert"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:minHeight="48dp" android:checked="true"
            android:text="Receber SMS de alerta" android:textColor="@color/ink"
            android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="hipo e hiper fora da faixa alvo"
            android:textColor="@color/text_muted_light" android:textSize="11sp" android:textStyle="bold"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swDlgReceivesReport"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:minHeight="48dp"
            android:text="Receber relatório" android:textColor="@color/ink"
            android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvReportHint"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="por e-mail — exige um endereço preenchido"
            android:textColor="@color/text_muted_light" android:textSize="11sp" android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:background="@drawable/bg_banner_consent"
            android:paddingHorizontal="12dp" android:paddingVertical="10dp"
            android:text="Ao salvar você confirma que esta pessoa pode receber dados de saúde da criança."
            android:textColor="#8A6D00" android:textSize="11sp" android:textStyle="bold"
            android:lineSpacingMultiplier="1.3"/>
    </LinearLayout>
</ScrollView>
