<?xml version="1.0" encoding="utf-8"?>

<!-- b19 · Rede de Apoio. Protegida por PIN (abre a partir de fragment_parent_area.xml → cvSupportNetwork).
     Lista SÓ LEITURA: edição sempre por dialog_contact.xml. Contexto por DOIS caminhos: btnContactMenu (⋮) e long-press. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F5F3FA">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/btnBack"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_circle_white" android:src="@drawable/ic_back_ink"
                android:contentDescription="Voltar para a Área dos Pais"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Rede de Apoio" android:textColor="@color/ink" android:textSize="19sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvNetworkSubtitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="protegida por PIN" android:textColor="@color/text_muted_light"
                    android:textSize="11sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:background="@drawable/bg_banner_consent"
            android:paddingHorizontal="14dp" android:paddingVertical="11dp"
            android:text="Ao adicionar alguém aqui você autoriza o envio de dados de saúde da criança para essa pessoa. As mensagens levam só o primeiro nome e a inicial do sobrenome."
            android:textColor="#8A6D00" android:textSize="11sp" android:textStyle="bold"
            android:lineSpacingMultiplier="1.35"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="18dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeWidth="1dp" app:strokeColor="#E3DAF7">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingVertical="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingVertical="8dp" android:text="CONTATOS"
                    android:textColor="@color/text_muted_light" android:textSize="12sp"
                    android:textStyle="bold" android:letterSpacing="0.05"/>
                <!-- ListView + BaseAdapter (item_contact.xml). registerForContextMenu neste ListView. -->
                <ListView android:id="@+id/lvContacts"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:divider="#F0EBFA" android:dividerHeight="1dp"
                    android:nestedScrollingEnabled="true"/>
                <TextView android:id="@+id/tvEmptyContacts"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:visibility="gone" android:paddingVertical="20dp" android:gravity="center"
                    android:text="Nenhum contato ainda — adicione quem deve receber os alertas."
                    android:textColor="@color/text_muted_light" android:textSize="12sp" android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddContact"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:minHeight="52dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:background="@drawable/bg_button_primary_3d" app:backgroundTint="@null"
            android:text="+ Adicionar pessoa" android:textColor="@android:color/white"
            android:textSize="14sp" android:textStyle="bold" android:textAllCaps="false"
            android:contentDescription="Adicionar uma pessoa à rede de apoio"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="18dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeWidth="1dp" app:strokeColor="#E3DAF7">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="16dp"
                android:divider="?android:attr/dividerHorizontal" android:showDividers="middle">

                <LinearLayout android:id="@+id/rowAlertSettings"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="13dp"
                    android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="Alertas automáticos" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvAlertSummary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_success_soft"
                        android:paddingHorizontal="12dp" android:paddingVertical="6dp"
                        android:text="Hipo ligado ›" android:textColor="#00785B" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/rowShareSummary"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="13dp"
                    android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="Compartilhar resumo de 7 dias" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_purple_soft"
                        android:paddingHorizontal="12dp" android:paddingVertical="6dp"
                        android:text="SMS ›" android:textColor="@color/primary_dark" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center"
            android:text="toque no ⋮ (ou segure o contato) para editar, remover ou enviar teste"
            android:textColor="@color/text_muted_light" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
</ScrollView>
