<?xml version="1.0" encoding="utf-8"?>
<!-- b1 · Splash (pós SplashScreen API). Fundo: gradiente night. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_night">

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="150dp" android:layout_height="150dp"
        android:src="@drawable/ic_avatar_1"
        android:background="@drawable/bg_dotted_ring"
        android:padding="12dp"
        android:contentDescription="Glico, mascote do GlicoKids"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.38"/>

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="GlicoKids"
        android:textColor="@android:color/white" android:textSize="40sp" android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>

    <!-- b1 · 3 pontos de carregamento (handoff-android.md §7). O código anima a opacidade em
         sequência; estáticos, continuam fiéis ao desenho. -->
    <LinearLayout
        android:id="@+id/llLoadingDots"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="72dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <View android:id="@+id/dotLoad1" android:layout_width="10dp" android:layout_height="10dp"
            android:layout_marginHorizontal="5dp" android:background="@drawable/bg_circle_teal"/>
        <View android:id="@+id/dotLoad2" android:layout_width="10dp" android:layout_height="10dp"
            android:layout_marginHorizontal="5dp" android:alpha="0.55" android:background="@drawable/bg_circle_teal"/>
        <View android:id="@+id/dotLoad3" android:layout_width="10dp" android:layout_height="10dp"
            android:layout_marginHorizontal="5dp" android:alpha="0.25" android:background="@drawable/bg_circle_teal"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Sua aventura na galáxia da glicose"
        android:textColor="@color/text_muted_dark" android:textSize="13sp" android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvAppName"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
