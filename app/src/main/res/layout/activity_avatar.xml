<?xml version="1.0" encoding="utf-8"?>
<!-- b14 · Escolha seu Glico (ImageSwitcher). SUBSTITUI o do staging.
     Correções de fidelidade: botões com bg_button_*_3d (sem pílula Material), estrela como vector
     (sem emoji), dots com id para o código alternar, card radius 24dp. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/lavender_bg">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginStart="16dp" android:layout_marginTop="16dp"
        android:background="@drawable/bg_circle_white" android:src="@drawable/ic_back_ink"
        android:contentDescription="Voltar"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Escolha seu Glico"
        android:textColor="@color/ink" android:textSize="21sp" android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnBack" app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAvatar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardCornerRadius="24dp" app:cardElevation="2dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/btnBack">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:padding="24dp">

            <ImageSwitcher
                android:id="@+id/isAvatar"
                android:layout_width="180dp" android:layout_height="180dp"/>

            <TextView
                android:id="@+id/tvAvatarName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Glico Clássico"
                android:textColor="@color/primary_dark" android:textSize="19sp" android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAvatarStatus"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="roupa 1 de 5 · desbloqueada"
                android:textColor="@color/text_muted_light" android:textSize="12sp" android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/llDots"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center">
                <View android:id="@+id/dotAvatar1" android:layout_width="8dp" android:layout_height="8dp" android:layout_margin="3dp" android:background="@drawable/bg_circle_teal"/>
                <View android:id="@+id/dotAvatar2" android:layout_width="8dp" android:layout_height="8dp" android:layout_margin="3dp" android:background="@drawable/bg_dot_inactive"/>
                <View android:id="@+id/dotAvatar3" android:layout_width="8dp" android:layout_height="8dp" android:layout_margin="3dp" android:background="@drawable/bg_dot_inactive"/>
                <View android:id="@+id/dotAvatar4" android:layout_width="8dp" android:layout_height="8dp" android:layout_margin="3dp" android:background="@drawable/bg_dot_inactive"/>
                <View android:id="@+id/dotAvatar5" android:layout_width="8dp" android:layout_height="8dp" android:layout_margin="3dp" android:background="@drawable/bg_dot_inactive"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/llNav"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/cardAvatar">
        <Button
            android:id="@+id/btnPrevious"
            style="@style/Widget.GlicoKids.Button.Outline"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:text="◀ Anterior" android:textSize="15sp"/>
        <Button
            android:id="@+id/btnNext"
            style="@style/Widget.GlicoKids.Button.Primary"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:text="Próximo ▶" android:textSize="15sp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnChooseAvatar"
        style="@style/Widget.GlicoKids.Button.Gold"
        android:layout_width="match_parent" android:layout_height="58dp"
        android:layout_marginHorizontal="24dp" android:layout_marginBottom="14dp"
        android:insetTop="0dp" android:insetBottom="0dp"
        android:drawableEnd="@drawable/ic_star_small" android:drawablePadding="8dp"
        android:text="Escolher este!" android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/tvFooterHint"/>

    <TextView
        android:id="@+id/tvFooterHint"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="as roupas são desbloqueadas com medalhas"
        android:textColor="@color/text_muted_light" android:textSize="11sp" android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
