<?xml version="1.0" encoding="utf-8"?>
<!-- b9 · Campo de texto do MUNDO CLARO (telas beta da criança).
     Valores do design doc b9: fundo branco, borda 2dp #D9CFF3, raio 16dp.
     Não confundir com bg_input_field, que é o campo do mundo escuro (f9: preto 30% + teal). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <stroke android:width="2.5dp" android:color="@color/primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <stroke android:width="2dp" android:color="#D9CFF3" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
